# 6. CLASE RESERVA (ESTADOS, CONFIRMACIÓN, CANCELACIÓN Y PROCESAMIENTO)
# ==============================================================================
class Reserva(EntidadSistema):
    """Integra un Cliente, un Servicio, la duración y el ciclo de vida de la reserva."""

    ESTADOS = ("PENDIENTE", "CONFIRMADA", "CANCELADA", "PROCESADA")

    def __init__(
        self,
        codigo_reserva: str,
        cliente: Cliente,
        servicio: Servicio,
        duracion_horas: int,
        descuento: float = 0.0,
        aplicar_iva: bool = True,
    ):
        super().__init__(codigo_reserva)

        if not isinstance(cliente, Cliente):
            raise ParametroFaltanteError("Se requiere una instancia válida de Cliente.")
        if not isinstance(servicio, Servicio):
            raise ParametroFaltanteError("Se requiere una instancia válida de Servicio.")
        if not servicio.disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{servicio.nombre}' ({servicio.identificador}) no está disponible."
            )
        if not isinstance(duracion_horas, int) or duracion_horas <= 0:
            raise ReservaInvalidaError("La duración de la reserva debe ser mayor a 0 horas.")

        self._cliente = cliente
        self._servicio = servicio
        self._duracion_horas = duracion_horas
        self._descuento = descuento
        self._aplicar_iva = aplicar_iva
        self._estado = "PENDIENTE"
        self._costo_total: Optional[float] = None
        self.validar_integridad()

    @property
    def cliente(self) -> Cliente:
        return self._cliente

    @property
    def servicio(self) -> Servicio:
        return self._servicio

    @property
    def estado(self) -> str:
        return self._estado

    @property
    def costo_total(self) -> Optional[float]:
        return self._costo_total

    def validar_integridad(self) -> bool:
        if self._estado not in self.ESTADOS:
            raise ReservaInvalidaError(f"Estado de reserva desconocido: {self._estado}")
        return True

    def confirmar(self) -> None:
        """Confirma la reserva si está pendiente y bloquea la disponibilidad del servicio."""
        if self._estado != "PENDIENTE":
            raise OperacionNoPermitidaError(
                f"No se puede confirmar la reserva {self._identificador} porque está en estado '{self._estado}'."
            )
        if not self._servicio.disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{self._servicio.nombre}' ya fue ocupado por otra reserva."
            )

        self._estado = "CONFIRMADA"
        self._servicio.disponible = False
        logger.info(f"Reserva {self._identificador} CONFIRMADA para {self._cliente.nombre}.")

    def cancelar(self, motivo: str = "Solicitud del cliente") -> None:
        """Cancela una reserva pendiente o confirmada y libera el servicio."""
        if self._estado in ("CANCELADA", "PROCESADA"):
            raise OperacionNoPermitidaError(
                f"No es posible cancelar la reserva {self._identificador} en estado '{self._estado}'."
            )

        estado_anterior = self._estado
        self._estado = "CANCELADA"
        if estado_anterior == "CONFIRMADA":
            self._servicio.disponible = True

        logger.warning(
            f"Reserva {self._identificador} CANCELADA (anterior: {estado_anterior}). Motivo: {motivo}"
        )

    def procesar(self, recargo_extra: float = 0.0) -> float:
        """
        Procesa y liquida una reserva confirmada.
        Utiliza bloque try/except/finally y encadenamiento de excepciones.
        """
        logger.info(f"Iniciando procesamiento de reserva {self._identificador}...")
        try:
            if self._estado != "CONFIRMADA":
                raise OperacionNoPermitidaError(
                    f"La reserva {self._identificador} debe estar CONFIRMADA para procesarse "
                    f"(estado actual: {self._estado})."
                )

            # Cálculo polimórfico del costo
            costo = self._servicio.calcular_costo(
                horas=self._duracion_horas,
                descuento=self._descuento,
                aplicar_iva=self._aplicar_iva,
                recargo_extra=recargo_extra,
            )
            self._costo_total = costo
            self._estado = "PROCESADA"
            # Una vez finalizado el servicio, vuelve a estar disponible
            self._servicio.disponible = True
            logger.info(
                f"Reserva {self._identificador} PROCESADA exitosamente. Total cobrado: ${costo:,.2f}"
            )
            return costo

        except SoftwareFJError:
            # Re-lanza excepciones controladas del dominio tras registrarlas
            raise
        except Exception as err:
            # Encadenamiento de excepciones para errores inesperados de cálculo
            raise CalculoInconsistenteError(
                f"Fallo inesperado al liquidar la reserva {self._identificador}."
            ) from err
        finally:
            logger.debug(
                f"Auditoría de cierre de intento de procesamiento -> Reserva: {self._identificador} | "
                f"Estado final: {self._estado}"
            )

    def obtener_resumen(self) -> str:
        costo_str = f"${self._costo_total:,.2f}" if self._costo_total is not None else "Por liquidar"
        return (
            f"Reserva [{self._identificador}] | Cliente: {self._cliente.nombre} | "
            f"Servicio: {self._servicio.nombre} | Horas: {self._duracion_horas} | "
            f"Estado: {self._estado} | Total: {costo_str}"
        )

