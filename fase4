# ==============================================================================
# 1. CONFIGURACIÓN DEL SISTEMA DE LOGS (ARCHIVO ÚNICO DE EVENTOS Y ERRORES)
# ==============================================================================
def configurar_logger(nombre_archivo: str = "software_fj.log") -> logging.Logger:
    """Configura el registro de eventos y errores en un archivo .log y consola."""
    logger = logging.getLogger("SoftwareFJ")
    logger.setLevel(logging.DEBUG)

    if not logger.handlers:
        formato = logging.Formatter(
            "%(asctime)s | %(levelname)-8s | %(module)s | %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )

        # Manejador de archivo (persiste todos los eventos y errores)
        file_handler = logging.FileHandler(nombre_archivo, mode="a", encoding="utf-8")
        file_handler.setLevel(logging.DEBUG)
        file_handler.setFormatter(formato)

        # Manejador de consola (muestra resumen en ejecución)
        console_handler = logging.StreamHandler()
        console_handler.setLevel(logging.INFO)
        console_handler.setFormatter(formato)

        logger.addHandler(file_handler)
        logger.addHandler(console_handler)

    return logger


logger = configurar_logger()


