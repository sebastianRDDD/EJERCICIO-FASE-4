# 3. CLASE ABSTRACTA BASE PARA ENTIDADES DEL SISTEMA
# ==============================================================================
class EntidadSistema(ABC):
    """Clase abstracta que representa cualquier entidad general dentro de Software FJ."""

    def __init__(self, identificador: str):
        if not identificador or not str(identificador).strip():
            raise ParametroFaltanteError("El identificador de la entidad es obligatorio.")
        self._identificador = str(identificador).strip()
        self._fecha_creacion = datetime.now()

    @property
    def identificador(self) -> str:
        return self._identificador

    @property
    def fecha_creacion(self) -> datetime:
        return self._fecha_creacion

    @abstractmethod
    def validar_integridad(self) -> bool:
        """Valida que los atributos internos de la entidad sean consistentes."""
        pass

    @abstractmethod
    def obtener_resumen(self) -> str:
        """Retorna una representación legible de la entidad."""
        pass


