# 5. CLASE ABSTRACTA SERVICIO Y SUS 3 ESPECIALIZACIONES (POLIMORFISMO)
# ==============================================================================
class Servicio(EntidadSistema, ABC):
    """Clase abstracta base para los servicios ofrecidos por Software FJ."""

    IVA_ESTANDAR = 0.19

    def __init__(self, codigo_servicio: str, nombre: str, tarifa_base_hora: float, disponible: bool = True):
        super().__init__(codigo_servicio)
        if not nombre or not str(nombre).strip():
            raise ParametroFaltanteError("El nombre del servicio es obligatorio.")

        self._nombre = str(nombre).strip()
        self._disponible = bool(disponible)

        # Validación con encadenamiento de excepciones ante tipos numéricos inválidos
        try:
            tarifa_num = float(tarifa_base_hora)
        except (TypeError, ValueError) as err:
            raise DatosInvalidosError(
                f"La tarifa base '{tarifa_base_hora}' no es un valor numérico válido."
            ) from err

        if tarifa_num <= 0:
            raise DatosInvalidosError("La tarifa base por hora debe ser mayor que cero.")

        self._tarifa_base_hora = tarifa_num

    @property
    def nombre(self) -> str:
        return self._nombre

    @property
    def tarifa_base_hora(self) -> float:
        return self._tarifa_base_hora

    @property
    def disponible(self) -> bool:
        return self._disponible

    @disponible.setter
    def disponible(self, estado: bool) -> None:
        if not isinstance(estado, bool):
            raise DatosInvalidosError("El estado de disponibilidad debe ser booleano (True/False).")
        self._disponible = estado

    @abstractmethod
    def validar_parametros(self) -> bool:
        """Valida los parámetros específicos de cada tipo de servicio."""
        pass

    @abstractmethod
    def describir_servicio(self) -> str:
        """Retorna una descripción detallada y polimórfica del servicio."""
        pass

    @abstractmethod
    def calcular_costo(
        self,
        horas: int,
        descuento: float = 0.0,
        aplicar_iva: bool = False,
        recargo_extra: float = 0.0,
    ) -> float:
        """
        Método polimórfico y sobrecargado mediante parámetros opcionales para calcular
        el costo total según horas, descuentos, IVA y recargos adicionales.
        """
        pass

    # Ejemplo adicional de sobrecarga por tipo de argumento usando singledispatchmethod
    @singledispatchmethod
    def aplicar_beneficio(self, beneficio: Union[float, str], monto: float) -> float:
        """Aplica un beneficio ya sea por porcentaje numérico (float) o cupón (str)."""
        raise DatosInvalidosError(f"Tipo de beneficio no soportado: {type(beneficio).__name__}")

    @aplicar_beneficio.register
    def _(self, beneficio: float, monto: float) -> float:
        if not (0.0 <= beneficio <= 0.50):
            raise CalculoInconsistenteError("El porcentaje de descuento debe estar entre 0% y 50%.")
        return round(monto * (1 - beneficio), 2)

    @aplicar_beneficio.register
    def _(self, beneficio: str, monto: float) -> float:
        cupones = {"UNAD10": 0.10, "SOFTWAREFJ20": 0.20, "VIP15": 0.15}
        clave = beneficio.strip().upper()
        if clave not in cupones:
            raise DatosInvalidosError(f"El cupón promocional '{beneficio}' no es válido.")
        return round(monto * (1 - cupones[clave]), 2)

    def _validar_horas_y_modificadores(self, horas: int, descuento: float, recargo_extra: float) -> None:
        if not isinstance(horas, int) or horas <= 0:
            raise ReservaInvalidaError("La duración de la reserva debe ser un entero positivo de horas.")
        if not (0.0 <= descuento < 1.0):
            raise CalculoInconsistenteError("El descuento debe estar en el rango [0.0, 1.0).")
        if recargo_extra < 0:
            raise CalculoInconsistenteError("El recargo extra no puede ser negativo.")

    def validar_integridad(self) -> bool:
        return self.validar_parametros()

    def obtener_resumen(self) -> str:
        estado = "Disponible" if self._disponible else "Ocupado/Inactivo"
        return f"[{self._identificador}] {self.describir_servicio()} ({estado})"


class ReservaSala(Servicio):
    """Servicio especializado 1: Alquiler de salas de reuniones, capacitación o juntas."""

    def __init__(
        self,
        codigo_servicio: str,
        nombre: str,
        tarifa_base_hora: float,
        capacidad_personas: int,
        incluye_audiovisual: bool = True,
        disponible: bool = True,
    ):
        super().__init__(codigo_servicio, nombre, tarifa_base_hora, disponible)
        self._capacidad_personas = capacidad_personas
        self._incluye_audiovisual = bool(incluye_audiovisual)
        self.validar_parametros()

    def validar_parametros(self) -> bool:
        if not isinstance(self._capacidad_personas, int) or not (2 <= self._capacidad_personas <= 200):
            raise DatosInvalidosError(
                "La capacidad de la sala debe ser un entero entre 2 y 200 personas."
            )
        return True

    def describir_servicio(self) -> str:
        av = "con equipo audiovisual" if self._incluye_audiovisual else "sin equipo audiovisual"
        return (
            f"Sala '{self._nombre}' (Capacidad: {self._capacidad_personas} pers., {av}) - "
            f"${self._tarifa_base_hora:,.2f}/h"
        )

    def calcular_costo(
        self,
        horas: int,
        descuento: float = 0.0,
        aplicar_iva: bool = False,
        recargo_extra: float = 0.0,
    ) -> float:
        self._validar_horas_y_modificadores(horas, descuento, recargo_extra)
        subtotal = self._tarifa_base_hora * horas
        # Costo fijo adicional si incluye soporte audiovisual
        if self._incluye_audiovisual:
            subtotal += 15000.0 * horas

        subtotal = subtotal * (1 - descuento) + recargo_extra
        total = subtotal * (1 + self.IVA_ESTANDAR) if aplicar_iva else subtotal

        if total <= 0:
            raise CalculoInconsistenteError("El costo calculado para la sala es inconsistente (<= 0).")
        return round(total, 2)


class AlquilerEquipo(Servicio):
    """Servicio especializado 2: Alquiler de equipos tecnológicos (servidores, laptops, drones)."""

    def __init__(
        self,
        codigo_servicio: str,
        nombre: str,
        tarifa_base_hora: float,
        categoria_equipo: str,
        cantidad_unidades: int,
        disponible: bool = True,
    ):
        super().__init__(codigo_servicio, nombre, tarifa_base_hora, disponible)
        self._categoria_equipo = categoria_equipo
        self._cantidad_unidades = cantidad_unidades
        self.validar_parametros()

    def validar_parametros(self) -> bool:
        if not self._categoria_equipo or not str(self._categoria_equipo).strip():
            raise ParametroFaltanteError("La categoría del equipo es obligatoria.")
        if not isinstance(self._cantidad_unidades, int) or self._cantidad_unidades <= 0:
            raise DatosInvalidosError("La cantidad de unidades del equipo debe ser al menos 1.")
        return True

    def describir_servicio(self) -> str:
        return (
            f"Alquiler Equipo '{self._nombre}' [Cat: {self._categoria_equipo}, "
            f"Unidades: {self._cantidad_unidades}] - ${self._tarifa_base_hora:,.2f}/h por unidad"
        )

    def calcular_costo(
        self,
        horas: int,
        descuento: float = 0.0,
        aplicar_iva: bool = False,
        recargo_extra: float = 0.0,
    ) -> float:
        self._validar_horas_y_modificadores(horas, descuento, recargo_extra)
        # El costo escala por hora y cantidad de unidades alquiladas
        subtotal = self._tarifa_base_hora * horas * self._cantidad_unidades
        # Seguro obligatorio del 5% por daño de hardware
        seguro_hardware = subtotal * 0.05
        subtotal = (subtotal + seguro_hardware) * (1 - descuento) + recargo_extra
        total = subtotal * (1 + self.IVA_ESTANDAR) if aplicar_iva else subtotal

        if total <= 0:
            raise CalculoInconsistenteError("El costo calculado para el equipo es inconsistente.")
        return round(total, 2)


class AsesoriaEspecializada(Servicio):
    """Servicio especializado 3: Consultoría y asesoría en arquitectura, ciberseguridad o IA."""

    NIVELES_VALIDOS = {"JUNIOR": 1.0, "SENIOR": 1.35, "ARQUITECTO": 1.75}

    def __init__(
        self,
        codigo_servicio: str,
        nombre: str,
        tarifa_base_hora: float,
        area_especialidad: str,
        nivel_consultor: str,
        disponible: bool = True,
    ):
        super().__init__(codigo_servicio, nombre, tarifa_base_hora, disponible)
        self._area_especialidad = area_especialidad
        self._nivel_consultor = nivel_consultor.strip().upper() if nivel_consultor else ""
        self.validar_parametros()

    def validar_parametros(self) -> bool:
        if not self._area_especialidad or not str(self._area_especialidad).strip():
            raise ParametroFaltanteError("El área de especialidad de la asesoría es obligatoria.")
        if self._nivel_consultor not in self.NIVELES_VALIDOS:
            raise DatosInvalidosError(
                f"Nivel de consultor '{self._nivel_consultor}' inválido. "
                f"Opciones: {list(self.NIVELES_VALIDOS.keys())}"
            )
        return True

    def describir_servicio(self) -> str:
        return (
            f"Asesoría '{self._nombre}' [Área: {self._area_especialidad}, "
            f"Nivel: {self._nivel_consultor}] - Tarifa base ${self._tarifa_base_hora:,.2f}/h"
        )

    def calcular_costo(
        self,
        horas: int,
        descuento: float = 0.0,
        aplicar_iva: bool = False,
        recargo_extra: float = 0.0,
    ) -> float:
        self._validar_horas_y_modificadores(horas, descuento, recargo_extra)
        multiplicador = self.NIVELES_VALIDOS[self._nivel_consultor]
        subtotal = (self._tarifa_base_hora * multiplicador) * horas
        subtotal = subtotal * (1 - descuento) + recargo_extra
        total = subtotal * (1 + self.IVA_ESTANDAR) if aplicar_iva else subtotal

        if total <= 0:
            raise CalculoInconsistenteError("El costo calculado para la asesoría es inconsistente.")
        return round(total, 2)


