# 2. JERARQUÍA DE EXCEPCIONES PERSONALIZADAS
# ==============================================================================
class SoftwareFJError(Exception):
    """Excepción base para todos los errores del sistema Software FJ."""

    def __init__(self, mensaje: str, codigo: str = "ERR-GEN"):
        self.codigo = codigo
        super().__init__(f"[{codigo}] {mensaje}")


class DatosInvalidosError(SoftwareFJError):
    """Se lanza cuando los datos ingresados no cumplen el formato o rango esperado."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, codigo="ERR-DATOS")


class ParametroFaltanteError(SoftwareFJError):
    """Se lanza cuando falta un parámetro obligatorio para crear o procesar una entidad."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, codigo="ERR-PARAM")


class OperacionNoPermitidaError(SoftwareFJError):
    """Se lanza cuando se intenta ejecutar una acción inválida según el estado actual."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, codigo="ERR-OPER")


class ReservaInvalidaError(SoftwareFJError):
    """Se lanza ante inconsistencias en la creación o gestión de una reserva."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, codigo="ERR-RES")


class ServicioNoDisponibleError(SoftwareFJError):
    """Se lanza cuando se solicita un servicio que está ocupado o inactivo."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, codigo="ERR-DISP")


class CalculoInconsistenteError(SoftwareFJError):
    """Se lanza cuando el cálculo de costos arroja valores negativos, nulos o incoherentes."""

